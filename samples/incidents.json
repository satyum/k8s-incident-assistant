[
  {
    "name": "crashloop-bad-config",
    "expected_signals": [
      "CrashLoopBackOff"
    ],
    "expected_runbook": "crash-loop-backoff",
    "incident": {
      "namespace": "samples",
      "pods": [
        {
          "name": "api-1",
          "phase": "Running",
          "containers": [
            {
              "name": "app",
              "ready": false,
              "restarts": 7,
              "waiting_reason": "CrashLoopBackOff",
              "waiting_message": null,
              "terminated_reason": null,
              "last_terminated_reason": "Error",
              "last_exit_code": 1
            }
          ],
          "logs": [
            "ERROR cannot read config /etc/app/settings.yaml",
            "Traceback: FileNotFoundError"
          ]
        }
      ],
      "events": [
        {
          "type": "Warning",
          "reason": "BackOff",
          "object": "api-1",
          "count": 3,
          "message": "Back-off restarting failed container app"
        }
      ]
    }
  },
